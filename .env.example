# 7BLOCKS CRM Environment Variables Example

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/sevenblocks_crm?schema=public"

# Server Ports
PORT=5000
API_PORT=5000
WEB_PORT=3000

# App URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:5000"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Email Configuration (Optional SMTP / SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="7BLOCKS Sales <sales@7blocks.com>"
SENDGRID_API_KEY=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# Timezone & Currency Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
