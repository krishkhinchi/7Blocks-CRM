# Multi-stage Dockerfile for 7BLOCKS CRM Web Frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy configuration and workspaces
COPY package*.json ./
COPY packages/shared ./packages/shared/
COPY apps/web ./apps/web/

# Install dependencies and build shared package & web application
RUN npm install
RUN npm run build --workspace=@7blocks/shared
RUN npm run build --workspace=@7blocks/web

# Production Web Server with Nginx
FROM nginx:alpine AS runner

WORKDIR /usr/share/nginx/html

# Clean default static assets
RUN rm -rf ./*

# Copy built frontend assets from builder stage
COPY --from=builder /app/apps/web/dist .

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
